{
  "name": "reservas-salas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema web de reservas de salas de reuniões",
  "license": "MIT",
  "author": "Jonatasklf",
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "dev:rede": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 127.0.0.1",
    "start:servidor": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "node scripts/banco-local.mjs start",
    "db:stop": "node scripts/banco-local.mjs stop",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "admin:criar": "tsx scripts/criar-admin.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16",
    "@radix-ui/react-dialog": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "next": "15.5",
    "nodemailer": "^10.5.0",
    "react": "19.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.1",
    "rrule": "2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "prisma": "6.16",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.6.0-beta.19": true,
    "@prisma/engines@6.16.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.16.3": true,
    "@prisma/client@6.16.3": true,
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-arm@18.6.0-beta.19": true,
    "@embedded-postgres/linux-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-ia32@18.6.0-beta.19": true,
    "@embedded-postgres/linux-ppc64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "typescript-eslint": "^8.72.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
