# =============================================================================
# Variáveis de PRODUÇÃO — copie para ".env.producao" no servidor e ajuste.
# Nunca envie o .env.producao para o GitHub.
# =============================================================================

# Seu domínio: SÓ o nome, sem https://, sem barra no final e sem caminho.
# O registro DNS tipo A deve apontar para o IP do servidor.
# Ainda sem domínio? Use o IP com sslip.io: "reservas.203-0-113-10.sslip.io"
# (troque pelo IP da VPS, com hífens). Veja HOSPEDAGEM.md, seção 3.1.
DOMINIO="reservas.seudominio.com.br"
APP_URL="https://reservas.seudominio.com.br"

# Senha do banco de dados (troque por uma senha longa e aleatória).
POSTGRES_PASSWORD="troque-esta-senha-do-banco"
DATABASE_URL="postgresql://reservas:troque-esta-senha-do-banco@banco:5432/reservas?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="gere-um-segredo-aleatorio-com-mais-de-32-caracteres"
SESSION_HOURS="12"

# E-mail (opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Reservas de Salas <nao-responda@seudominio.com.br>"
