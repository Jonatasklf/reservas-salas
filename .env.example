# =============================================================================
# Variáveis de ambiente — copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo .env para o GitHub (ele já está no .gitignore).
# =============================================================================

# Banco de dados principal (PostgreSQL). Funciona tanto com o Docker Compose
# quanto com o banco local sem Docker (scripts/banco-local.mjs).
DATABASE_URL="postgresql://reservas:reservas_local@localhost:5433/reservas?schema=public"

# Banco usado SOMENTE pelos testes automatizados (é apagado a cada execução).
DATABASE_URL_TEST="postgresql://reservas:reservas_local@localhost:5433/reservas_teste?schema=public"

# Segredo usado para assinar a sessão dos administradores.
# Gere um valor aleatório longo (o instalar.bat faz isso automaticamente):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres"

# Duração da sessão administrativa, em horas.
SESSION_HOURS="12"

# Endereço público do sistema (usado em links de e-mail).
APP_URL="http://localhost:3000"

# --- Dados de demonstração (npm run db:seed) ---------------------------------
# Se definidos, o seed cria um administrador de DEMONSTRAÇÃO com estes dados.
# Em produção, deixe em branco e use "npm run admin:criar".
SEED_ADMIN_EMAIL="admin@exemplo.local"
SEED_ADMIN_PASSWORD="Demo@12345"

# --- E-mail (opcional) -------------------------------------------------------
# Sem SMTP configurado, o sistema funciona normalmente e apenas registra no
# console as mensagens que seriam enviadas.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Reservas de Salas <nao-responda@exemplo.local>"
